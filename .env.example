GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=print_db
DB_USER=root
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# Optional least-privilege credentials for AI analytics snapshots.
# Leave empty to use the normal DB_USER credentials.
DB_READONLY_USER=
DB_READONLY_PASSWORD=
